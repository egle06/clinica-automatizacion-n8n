    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || '';\nconst clean = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\nlet data;\ntry {\n  data = JSON.parse(clean);\n} catch (e) {\n  data = {\n    prioridad: 'normal',\n    resumen: 'No se pudo interpretar la respuesta de la IA',\n    accion_requerida: 'Revisar manualmente',\n    telefono_e164: ''\n  };\n}\nconst mail = $('Gmail Trigger').first().json;\nreturn [{\n  json: {\n    ...data,\n    prioridad: String(data.prioridad || 'normal').toLowerCase(),\n    remitente: (mail.from && mail.from.text) ? mail.from.text : '',\n    asunto: mail.subject || '',\n    threadId: mail.threadId || ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
